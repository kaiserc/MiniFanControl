<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MiniFanControl.Tests</AssemblyName>
    <RootNamespace>MiniFanControl</RootNamespace>
    <DefineConstants>$(DefineConstants);INCLUDE_SELF_TESTS;STANDALONE_TEST_RUNNER</DefineConstants>
    <NoWarn>$(NoWarn);WFDEV006;CS0618;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniFanControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\app.manifest" Link="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
