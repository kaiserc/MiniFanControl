# Normalize text line endings consistently across Windows & CI
* text=auto

*.cs text eol=crlf
*.csproj text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
*.manifest text eol=crlf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.mp4 binary
*.pptx binary
